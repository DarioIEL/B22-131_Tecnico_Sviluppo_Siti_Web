package lezione01_Intro;

public class Operatori {

	public static void main(String[] args) {
		
		//Operatori di assegnazione = 
		int num1 = 8;
		
		int num2 = 7;
		
		//Operatori di confronto o relazionali --- producono sempre un boolean
		// == uguale a (utile a confrontare variabili e non oggetti)
		// > o >= 
		//< o <= 
		//!= diverso da ---> ! NOT logico
		
		boolean conf1 = num1 == num2; //false
		System.out.println(conf1);
		
		boolean conf2 = num1 != num2; //true
		System.out.println(conf2);
		
		boolean conf3 = num1 >= num2; //true
		System.out.println(conf3);
		
//		Operatori di POST (prima leggo poi cambio il valore) incremento e decremento (++) (--) di 1
		int a = 3;
		
		a++; //a = a + 1
		
		System.out.println("Il numero a vale " + a);
		
		a--;
		
		System.out.println("Il numero a vale " + a);
		
//		Operatori di PRE (prima cambia valore poi legge) incremento e decremento
		
		int b = 5;
		
//		--b;
		
		System.out.println("Il valore di b è " + ++b);
		System.out.println(b);
		
		
		//Operatori assegnazione matematica += -= *= /=
		
		int c = 10;
		
		//voglio modificare il valore della variabile aggiungendo 5
		c += 5; //c = c + 5
	
		c -= 6;
		
		c *= 3;
		
		System.out.println(c);
		
		
		
		
	}

}
