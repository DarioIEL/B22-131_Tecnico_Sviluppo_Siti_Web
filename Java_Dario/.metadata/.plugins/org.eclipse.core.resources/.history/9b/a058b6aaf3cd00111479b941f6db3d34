package lezione01_Intro;

public class Array {
	public static void main(String[] args) {
		
		//Gli array sono dei contenitori di elementi simili tra loro (sono dello stesso tipo)
		//Anche gli array come le stringhe sono 0-based
		//Li dichiariamo utilizzando le []
		//Anche in questo caso parliamo di oggetti -> memoria Heap
		//GLi array sono a grandezza fissa. Quando li dichiaro devo decidere quante saranno le posizioni all'interno dell'array
		
		// il numero 4 tra [] definisce la dimensione dell'array
		String[] colori = new String[4];
		
		//assegno un valore ad ogni posizione
		// 0, 1,2,3 sono indici
		colori[0] = "Blu";
		colori[1] = "Rosso";
		colori[2] = "Viola";
		colori[3] = "Giallo";
//		colori[4] = "Verde"; NON POSSO INSERIRLO, L'ARRAY MISURA SOLO 4 posizioni
		
		
		int lunghezzaArray = colori.length; //length nel caso degli array è una proprietà
		
		System.out.println("L'array contiene " + lunghezzaArray + " colori");
		System.out.println("Il primo colore è " + colori[0]);
		System.out.println("L'ultimo colore è " + colori[colori.length -1]);

		System.out.println(colori ); //Qui sto stampando il puntatore
		
		//Per leggere i singoli colori uso un ciclo for
		
		for(int i = 0; i < colori.length; i++) {
			System.out.println(colori[i]);
		}
		
		System.out.println("FOREACH sui colori");
		for (String colore : colori) {
			System.out.println(colore);
		}
		
		System.out.println("Stampo lista colori al contrario");
		for(int i = colori.length - 1 ; i >= 0; i--) {
			System.out.println(colori[i]);
		}
		
		//Esiste un altro modo di definire l'array. Anche questi sono a grandezza fissa
		String[] nomi = {"Marco", "Anna", "Luca", "Maria"};
		System.out.println("Nell'array ci sono " + nomi.length + " nomi");
		System.out.println(nomi.toString());
	}
}
