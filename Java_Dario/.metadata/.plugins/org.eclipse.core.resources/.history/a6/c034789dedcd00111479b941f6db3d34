package lezione02_Statement;

public class for_Statement {
/**
 * Il ciclo for permette di ripetere un'istruzione per un numero definiti di volte. Fa parte quindi
 * della famiglia dei cicli definiti.
 */
	
/**
 * SINTASSI:
 *     inizializzazione   condizione  aggiornamento
 * for(int i = 0;         i < 3;      i++){
 * 		..corpo del for, viene eseguito finché la condizione è TRUE
 * }
 * 
 */
	public static void main(String[] args) {
		
		for (int i = 0; i < 3; i++) {
			System.out.println("Ciao " + i);
		}
	
		System.out.println("For al contrario");

		for (int i = 3; i > 0; i--) {
			System.out.println("Ciao " + i);
		}
		
		
		System.out.println("For con doppia variabile");
		
		for(int i = 0, j = 10; j >= 0 && i <= 10; j--, i++) {
			System.out.println("Ciao i = " + i +  "; j = " + j);
		}
		
		
		//continue e break
	}
}
