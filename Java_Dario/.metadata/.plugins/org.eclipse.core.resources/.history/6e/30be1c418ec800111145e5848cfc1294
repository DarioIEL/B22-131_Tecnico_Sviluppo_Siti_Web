package lezione01_Intro;

public class TipiDiDato {

	public static void main(String[] args) {

		// TIPI DI DATO PRIMITIVI

		// Numeri interi
		byte eta = 30; // 8 bit (-128 a +127)

		short litriPiscina = 30000; // 16 bit (-32.000 a +32.000)

		int soldiInBanca = 1000000000; // 32 bit

		long etaTerraInOre = 400000000000L; // 64 bit

		// Numeri con la virgola

		final float pigreco = 3.14f;

		final double nepero = 2.71;
		
		

	}
}
